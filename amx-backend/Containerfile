# =========================
# Build stage
# =========================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY index.js ./

RUN npm run build


# =========================
# Production stage
# =========================
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./

RUN npm ci --omit=dev

COPY --from=builder /app/dist/index.js ./index.js

EXPOSE 5000

USER node

CMD ["node", "index.js"]