# ==========================================
# Build stage
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first for better layer caching
COPY package*.json ./

RUN npm ci

# Copy application source
COPY . .

# ==========================================
# Build-time environment variables
# ==========================================

ENV KEYCLOAK_CLIENT_ID=staging
ENV KEYCLOAK_CLIENT_SECRET=uV8ZzGjRUs7EuzgSXm626AliHTx6VFM0
ENV KEYCLOAK_ISSUER=http://172.18.61.71:8080/realms/staging

ENV AUTH_SECRET=Wlu7mUmXUCP57714gRYsG4FjVSynQdQkGzrJYbL4EC0=
ENV NEXTAUTH_SECRET=Wlu7mUmXUCP57714gRYsG4FjVSynQdQkGzrJYbL4EC0=
ENV AUTH_TRUST_HOST=true
ENV NEXTAUTH_URL=http://172.18.61.53:3000

ENV NEXT_PUBLIC_BACKEND_URL=http://172.18.61.53:5000
ENV NEXT_PUBLIC_BACKEND2_URL=http://172.18.61.53:5001

# Build Next.js
RUN npm run build


# ==========================================
# Production stage
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

# ==========================================
# Runtime environment
# ==========================================

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

# ==========================================
# Auth / Keycloak
# ==========================================

ENV KEYCLOAK_CLIENT_ID=staging
ENV KEYCLOAK_CLIENT_SECRET=uV8ZzGjRUs7EuzgSXm626AliHTx6VFM0
ENV KEYCLOAK_ISSUER=http://172.18.61.71:8080/realms/staging

ENV AUTH_SECRET=Wlu7mUmXUCP57714gRYsG4FjVSynQdQkGzrJYbL4EC0=
ENV NEXTAUTH_SECRET=Wlu7mUmXUCP57714gRYsG4FjVSynQdQkGzrJYbL4EC0=
ENV AUTH_TRUST_HOST=true
ENV NEXTAUTH_URL=http://172.18.61.53:3000

# ==========================================
# Browser-accessible backend URLs
# ==========================================

ENV NEXT_PUBLIC_BACKEND_URL=http://172.18.61.53:5000
ENV NEXT_PUBLIC_BACKEND2_URL=http://172.18.61.53:5001


# ==========================================
# Create non-root user
# ==========================================

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs


# ==========================================
# Copy Next.js standalone runtime
# ==========================================

COPY --from=builder --chown=nextjs:nodejs \
    /app/.next/standalone ./


# ==========================================
# Copy Next.js static assets
# ==========================================

COPY --from=builder --chown=nextjs:nodejs \
    /app/.next/static ./.next/static


# ==========================================
# Run as non-root
# ==========================================

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]