FROM node:22-bookworm-slim

WORKDIR /app

# Install tools required by shell scripts
RUN apt-get update && apt-get install -y \
    bash \
    expect \
    telnet \
    curl \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN npm ci --omit=dev

COPY . .

RUN chmod +x send_channel.sh \
    && chmod +x stb_reboot.sh

EXPOSE 5001

CMD ["npm", "start"]