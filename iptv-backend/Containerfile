# ==========================================
# Build stage
# ==========================================
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including esbuild
RUN npm ci

# Copy application source
COPY index.js ./
COPY utils ./utils

# Bundle and minify application
RUN npm run build


# ==========================================
# Production stage
# ==========================================
FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --omit=dev

# Copy only bundled application
COPY --from=builder /app/dist/index.js ./index.js

# Application port
EXPOSE 5001

# Run as non-root user
USER node

CMD ["node", "index.js"]